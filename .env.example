# Template only. Copy this file to .env; the application never loads .env.example.
# Replace sample database credentials if you change the PostgreSQL role/password.
DEBUG=false
DATABASE_URL=postgresql+asyncpg://lenny:change-me-local-only@127.0.0.1:5432/lenny_assistant

# Native PostgreSQL on Windows uses port 5432. Compose overrides the backend URL
# to use its internal "db" host; POSTGRES_PORT controls the optional host mapping.
POSTGRES_DB=lenny_assistant
POSTGRES_USER=lenny
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DATABASE_URL=postgresql+asyncpg://lenny:change-me-local-only@127.0.0.1:5432/lenny_assistant

# Persistent vector index (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Ollama model
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=600

# Optional cloud providers. Keep real keys only in .env, never in frontend variables.
CLOUD_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_TIMEOUT=30

# Chunking and retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# Optional extra browser origins (JSON array)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
